{
  "info": {
    "_postman_id": "c1827184-c686-438e-8c2f-4cc1845fc0fd",
    "name": "Toka Checkout API",
    "description": "Flujo completo del checkout con pruebas automáticas. Ejecutar en orden (Runner o Newman). Requiere el entorno `local` con `baseUrl` y `apiKey` (valor de API_KEY en .env).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Api-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Un correo nuevo por corrida para no depender de datos previos.",
          "if (!pm.collectionVariables.get('email')) {",
          "  pm.collectionVariables.set('email', `postman.${Date.now()}@correo.mx`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "paidOrderId",
      "value": ""
    },
    {
      "key": "declinedOrderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Catálogo y formas de pago",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con 4 productos', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.lengthOf(4);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Formas de pago con tarjeta de crédito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/installment-plans?amount=3499&bin=411111",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "installment-plans"
              ],
              "query": [
                {
                  "key": "amount",
                  "value": "3499"
                },
                {
                  "key": "bin",
                  "value": "411111"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('Crédito: contado, 3 y 6 MSI', () => {",
                  "  pm.expect(d.cardTypeDisplay).to.eql('Crédito');",
                  "  pm.expect(d.plans.map(p => p.months)).to.eql([1, 3, 6]);",
                  "});",
                  "pm.test('El primer pago absorbe el redondeo', () => {",
                  "  pm.expect(d.plans[1].label).to.eql('3 pagos de $1,166.33 sin intereses; el primero de $1,166.34');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Formas de pago con tarjeta de débito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/installment-plans?amount=3499&bin=400005",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "installment-plans"
              ],
              "query": [
                {
                  "key": "amount",
                  "value": "3499"
                },
                {
                  "key": "bin",
                  "value": "400005"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Débito: solo contado', () => {",
                  "  pm.expect(pm.response.json().plans.map(p => p.months)).to.eql([1]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Checkout",
      "item": [
        {
          "name": "Compra aprobada a 3 MSI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"firstName\": \"Ana\",\n    \"lastName\": \"López\",\n    \"email\": \"{{email}}\",\n    \"phone\": \"55 1234 5678\"\n  },\n  \"productId\": \"0199a0d4-0000-7000-8000-000000000002\",\n  \"quantity\": 1,\n  \"installments\": 3,\n  \"card\": {\n    \"holderName\": \"ANA LOPEZ\",\n    \"number\": \"4111111111111111\",\n    \"expiryMonth\": 12,\n    \"expiryYear\": 2030,\n    \"cvv\": \"123\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set('paidOrderId', o.id);",
                  "pm.test('201 y pago aprobado', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(o.status).to.eql('Paid');",
                  "  pm.expect(o.statusDisplay).to.eql('Pago aprobado');",
                  "});",
                  "pm.test('IVA desglosado que cuadra', () => {",
                  "  pm.expect(o.subtotal + o.taxAmount).to.be.closeTo(o.total, 0.001);",
                  "  pm.expect(o.taxRate).to.eql(0.16);",
                  "});",
                  "pm.test('Pagos MSI suman el total', () => {",
                  "  pm.expect(o.firstPayment + o.monthlyPayment * (o.installments - 1)).to.be.closeTo(o.total, 0.001);",
                  "});",
                  "pm.test('Solo últimos 4 dígitos', () => pm.expect(o.attempts[0].cardLast4).to.eql('1111'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir con el mismo Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
