              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con la orden original, sin segundo cobro', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const o = pm.response.json();",
                  "  pm.expect(o.id).to.eql(pm.collectionVariables.get('paidOrderId'));",
                  "  pm.expect(o.attempts).to.have.lengthOf(1);",
                  "});"
                ]
              }
            }
          ]
        },
