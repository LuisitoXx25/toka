            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"firstName\": \"Ana\",\n    \"lastName\": \"López\",\n    \"email\": \"{{email}}\",\n    \"phone\": \"55 1234 5678\"\n  },\n  \"productId\": \"0199a0d4-0000-7000-8000-000000000002\",\n  \"quantity\": 1,\n  \"installments\": 1,\n  \"card\": {\n    \"holderName\": \"ANA LOPEZ\",\n    \"number\": \"4000000000000002\",\n    \"expiryMonth\": 12,\n    \"expiryYear\": 2030,\n    \"cvv\": \"123\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set('declinedOrderId', o.id);",
                  "pm.test('201 con estado rechazado y reintento permitido', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(o.status).to.eql('PaymentDeclined');",
                  "  pm.expect(o.failureReason).to.eql('Fondos insuficientes.');",
                  "  pm.expect(o.canRetryPayment).to.be.true;",
                  "});"
