              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSP, nosniff y sin caché', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Security-Policy')).to.include(\"default-src 'none'\");",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
                  "  pm.expect(pm.response.headers.get('X-Correlation-Id')).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Salud (sin API key)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
