            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"firstName\": \"Ana\",\n    \"lastName\": \"López\",\n    \"email\": \"{{email}}\",\n    \"phone\": \"55 1234 5678\"\n  },\n  \"productId\": \"0199a0d4-0000-7000-8000-000000000002\",\n  \"quantity\": 1,\n  \"installments\": 3,\n  \"card\": {\n    \"holderName\": \"ANA LOPEZ\",\n    \"number\": \"4111111111111111\",\n    \"expiryMonth\": 12,\n    \"expiryYear\": 2030,\n    \"cvv\": \"123\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
