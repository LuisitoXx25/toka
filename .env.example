# Copy with ./scripts/init-env.sh, which fills every value with a random secret.
# .env is git-ignored; never commit real values.

# PostgreSQL superuser. Only used by the container to initialize the database.
POSTGRES_PASSWORD=
# Schema owner: runs migrations only.
TOKA_OWNER_PASSWORD=
# Runtime user of the API: read/insert/update, no DDL, cannot run emergency corrections.
TOKA_APP_PASSWORD=
# Key the web proxy sends to the API. Also accepted by Swagger/Postman on http://localhost:8080.
API_KEY=

# Optional
WEB_PORT=5173
API_PORT=8080
SWAGGER_ENABLED=true
