server_tokens off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 64k;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # --- API allowlist: only the calls the checkout UI makes. Everything else under /api is 404. ---

    location = /api/v1/products {
        limit_except GET { deny all; }
        include /etc/nginx/conf.d/proxy-api.inc;
    }

    location = /api/v1/installment-plans {
        limit_except GET { deny all; }
        include /etc/nginx/conf.d/proxy-api.inc;
    }

    location = /api/v1/orders {
        limit_except POST { deny all; }
        include /etc/nginx/conf.d/proxy-api.inc;
    }

    location = /api/v1/orders/lookup {
        limit_except POST { deny all; }
        include /etc/nginx/conf.d/proxy-api.inc;
    }

    location ~ "^/api/v1/orders/[0-9a-fA-F-]{36}/payment-retries$" {
        limit_except POST { deny all; }
        include /etc/nginx/conf.d/proxy-api.inc;
    }

    # Customers (personal data), order by id, Swagger and health checks are not reachable from the web.
    location /api/ {
        default_type application/problem+json;
        return 404 '{"title":"Recurso no encontrado.","status":404}';
    }

    # --- Static app ---

    # Hashed file names: safe to cache for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA routes (/compras, /compras/{id}) fall back to index.html, which is never cached so deploys apply at once.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
