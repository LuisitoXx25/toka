# Forwards an allowed request to the API. The API key is added here, server side;
# any X-Api-Key sent by the browser is overwritten.
proxy_pass ${API_UPSTREAM};
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Api-Key "${API_KEY}";
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
# Payment with retries and gateway timeouts can take a while; the UI gives up at 20 s.
proxy_read_timeout 30s;
