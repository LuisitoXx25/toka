{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Migrations": ""
  },
  "Security": {
    "ApiKeys": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimiting": {
    "GlobalPerMinute": 120,
    "CheckoutPerMinute": 10,
    "LookupPerMinute": 20
  },
  "Payments": {
    "MaxAttempts": 3,
    "BaseRetryDelay": "00:00:00.200"
  },
  "Installments": {
    "Plans": [
      { "Months": 3, "MinimumAmount": 1500 },
      { "Months": 6, "MinimumAmount": 3000 }
    ]
  },
  "PaymentSimulator": {
    "Latency": "00:00:00.150",
    "Timeout": "00:00:02",
    "CardLimit": 100000
  }
}
